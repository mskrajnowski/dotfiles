#!/usr/bin/bash
set -euo pipefail

echo "Default settings"
sbx settings set browser.enabled true
sbx settings set clipboard.imagePaste true
sbx settings set diagnostics.autoUpload no
sbx settings set platform.allowExperimentalFeatures true
sbx settings set skills.defaultMode off
sbx settings set ssh.agentForwardingEnabled false
sbx daemon restart

echo "Setting default policy to allow all"
echo | sbx policy reset --force
sbx policy init allow-all

echo "Deny IPv6 and 6to4 relay"
sbx policy deny network ::/0,192.88.99.0/24

echo "Deny multicast and broadcast"
sbx policy deny network 224.0.0.0/4,255.255.255.255

echo "Deny localhost"
sbx policy deny network localhost,127.0.0.1,0.0.0.0/8

echo "Deny loopback 127.0.0.0/8, except for 127.1.0.0/16"
echo "127.1.0.0/16 is used to share services with agents, e.g. forge.local"
sbx policy deny network 127.0.0.0/16,127.2.0.0/15,127.4.0.0/14,127.8.0.0/13,127.16.0.0/12,127.32.0.0/11,127.64.0.0/10,127.128.0.0/9

echo "Deny local networks"
sbx policy deny network 10.0.0.0/8,100.64.0.0/10,169.254.0.0/16,172.16.0.0/12,192.0.0.0/24,192.168.0.0/16,198.18.0.0/15

echo "Deny reserved class E and TEST-NETs"
sbx policy deny network 240.0.0.0/4,192.0.2.0/24,198.51.100.0/24,203.0.113.0/24

echo "Policies set"
sbx policy ls
