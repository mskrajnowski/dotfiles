{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.2",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "plan",
  "permission": "allow",
  "agent": {
    // use big model for architectural decisions
    "plan": { "model": "opencode-go/glm-5.2" },
    "general": { "model": "opencode-go/glm-5.2" },

    // use small model for implementation and code search
    "build": { "model": "opencode-go/deepseek-v4-flash" },
    "explore": { "model": "opencode-go/deepseek-v4-flash" },

    // use small model for opencode maintenance tasks
    "title": { "model": "opencode-go/deepseek-v4-flash" },
    "summary": { "model": "opencode-go/deepseek-v4-flash" },
    "compaction": { "model": "opencode-go/deepseek-v4-flash" }
  },
  "lsp": {
    "pyrefly": {
      "extensions": [".py", ".pyi"],
      "command": ["pyrefly", "lsp"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        // sbx secret set-custom -g --placeholder 'ctx7sk-proxy-managed' --host mcp.context7.com
        "CONTEXT7_API_KEY": "ctx7sk-proxy-managed"
      },
      "enabled": true
    }
  }
}
