#!/usr/bin/bash
# Create agent home and sandbox
# Usage:
#   agent-create NAME

set -euo pipefail

name=$1
home="/home/agents/$name"
shift 1

echo "creating agent $name with HOME=$home"

# figure out where dotfiles repo is
script_path=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$script_path")
dotfiles_dir=$(realpath "$bin_dir/../../..")

agent_kit_dir="$dotfiles_dir/agent/agent-kit"
agent_env_template="$dotfiles_dir/agent/agent.template.yaml"
agent_env="/home/agents/$name.yaml"
agent_home="/home/agents/$name"

if ! [ -d /home/agents ]; then
  echo "creating /home/agents"
  sudo mkdir -p /home/agents
  sudo chown $(id -u):$(id -g) /home/agents
fi

echo "creating $agent_home"
mkdir -p "$agent_home"

echo "creating forge user"
forge-admin user create --username $name --email $name@localhost --random-password --must-change-password=false
forge_token=$(forge-admin user generate-access-token --username $name --raw)

cat >"$agent_home/.netrc" <<EOF
machine forge.local
login $name
password $forge_token
EOF
chmod 600 "$agent_home/.netrc"

echo "adding $name to dotfiles and agent-dotfiles repos"
forge-add-collaborator mskrajnowski/dotfiles $name
forge-add-collaborator mskrajnowski/agent-dotfiles $name

echo "creating env spec $agent_env"
env -i AGENT_NAME="$name" AGENT_KIT_DIR="$agent_kit_dir" FORGE_TOKEN="$forge_token" \
  envsubst <"$agent_env_template" >"$agent_env"

echo "creating env $agent_env"
sbx env create "$agent_env"

echo "agent env ready, enter with:"
echo "  agent-run $name"
