#!/usr/bin/env bash

set -ex

dotfiles_dir="$(dirname "$0")/.."

# prevent stow from folding directories,
# which it shouldn't own
mkdir -p \
  "$HOME/.local/bin" \
  "$HOME/.local/share/applications" \
  "$HOME/.config" \
  "$HOME/.config/git" \
  "$HOME/.config/fish" \
  "$HOME/.config/mise" \
  "$HOME/.config/alacritty/themes" \
  "$HOME/.config/ghostty/themes" \
  "$HOME/.config/jj/conf.d" \
  "$HOME/.config/zed" \
  "$HOME/.forge"

stow --dir "$dotfiles_dir" --target "$HOME" --adopt \
  agent \
  codestyle \
  git \
  zsh \
  fish \
  alacritty \
  ghostty \
  aider \
  mise \
  starship \
  jujutsu \
  zed \
  sbx \
  kde \
  forge

if ! grep -Fq forge.local /etc/hosts; then
  echo Adding forge.local to /etc/hosts
  echo 127.1.0.1 forge.local | sudo tee -a /etc/hosts
fi
